# ==============================================================================
# GenAI Conversational Platform Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="GenAI Conversational Platform"
APP_ENV="development" # development | testing | production
API_V1_STR="/api/v1"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# Ollama Local LLM Runtime (Strict Phase 1 Constraint: Local only, no external APIs)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_GENERATION_MODEL="qwen2.5:7b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_MAX_RETRIES=2

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIRECTORY="./data/chroma"
CHROMA_COLLECTION_NAME="genai_knowledge_base"
CHROMA_DISTANCE_METRIC="cosine"

# RAG & Ingestion Parameters
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_TOKENS=2048
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Storage Paths
DATA_DOCUMENTS_DIR="./data/documents"
DATA_PROCESSED_DIR="./data/processed"

